                <mxCell id="20" value="&lt;b&gt;Analysis Tools:&lt;/b&gt;&lt;br&gt;• get_sales_data(start_date, end_date)&lt;br&gt;• get_sales_forecast(start_date, end_date)&lt;br&gt;• calculate_sales_growth(start_date, end_date)&lt;br&gt;• calculate_forecast_accuracy(start_date, end_date)&lt;br&gt;• plot_the_data(start_date, end_date, plot_type)&lt;br&gt;• create_report(start_date, end_date)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="320" y="93" width="280" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="&lt;b&gt;Security Guardrails:&lt;/b&gt;&lt;br&gt;&lt;u&gt;Input Validation:&lt;/u&gt;&lt;br&gt;• SQL Injection Prevention&lt;br&gt;• Malicious Code Detection&lt;br&gt;• Input Sanitization&lt;br&gt;• Rate Limiting&lt;br&gt;&lt;u&gt;Output Validation:&lt;/u&gt;&lt;br&gt;• PII Detection &amp;amp; Removal&lt;br&gt;• Data Validation&lt;br&gt;• Error Handling&lt;br&gt;• Format Sanitization" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="830" y="90" width="280" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="22" value="&lt;b&gt;Architecture Principles:&lt;/b&gt;&lt;br&gt;✓ &lt;b&gt;Separation of Concerns:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- filter_the_data handles dimensions&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(city, shop, brand, container)&lt;br&gt;&amp;nbsp;&amp;nbsp;- Analysis tools handle dates&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(start_date, end_date)&lt;br&gt;✓ &lt;b&gt;Global Cache Pattern:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- _filtered_data stores dimensional&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;subset for reuse across tools&lt;br&gt;✓ &lt;b&gt;Date-Level Aggregation:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Aggregates sales to daily level&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;across all dimensions" style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="320" y="220" width="280" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="23" value="&lt;b&gt;Data Storage:&lt;/b&gt;&lt;br&gt;📊 &lt;b&gt;Sales Data (Historical)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- Monthly granularity&lt;br&gt;&amp;nbsp;&amp;nbsp;- Dimensions: city, shop, brand,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;container, timeseries_id&lt;br&gt;📈 &lt;b&gt;Forecast Data (Future)&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- yhat predictions&lt;br&gt;&amp;nbsp;&amp;nbsp;- Same dimensional structure&lt;br&gt;💾 &lt;b&gt;Global Cache&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;- _filtered_data variable" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=5;spacingTop=5;" parent="1" vertex="1">
                    <mxGeometry x="830" y="300" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="24" value="Time Series Sales Analytics Chatbot - Multi-layer Security Architecture with Separation of Concerns" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;fontColor=#666666;" parent="1" vertex="1">
